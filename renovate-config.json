{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Concertable organization dependency policy",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "mode": "full",
  "configMigration": true,
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Shared .NET platform train pin",
      "managerFilePatterns": [
        "/(^|/)Directory\\.Packages\\.props$/"
      ],
      "matchStrings": [
        "<ConcertableDotNetPlatformVersion>(?<currentValue>[^<]+)</ConcertableDotNetPlatformVersion>"
      ],
      "depNameTemplate": "Concertable.Kernel",
      "datasourceTemplate": "nuget",
      "registryUrlTemplate": "https://nuget.pkg.github.com/Concertable/index.json",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "description": "Auth train pin",
      "managerFilePatterns": [
        "/(^|/)Directory\\.Packages\\.props$/"
      ],
      "matchStrings": [
        "<ConcertableAuthVersion>(?<currentValue>[^<]+)</ConcertableAuthVersion>"
      ],
      "depNameTemplate": "Concertable.Auth.Hosting",
      "datasourceTemplate": "nuget",
      "registryUrlTemplate": "https://nuget.pkg.github.com/Concertable/index.json",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "description": "B2B contracts train pin",
      "managerFilePatterns": [
        "/(^|/)Directory\\.Packages\\.props$/"
      ],
      "matchStrings": [
        "<ConcertableB2BContractsVersion>(?<currentValue>[^<]+)</ConcertableB2BContractsVersion>"
      ],
      "depNameTemplate": "Concertable.B2B.Hosting",
      "datasourceTemplate": "nuget",
      "registryUrlTemplate": "https://nuget.pkg.github.com/Concertable/index.json",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "description": "Customer train pin",
      "managerFilePatterns": [
        "/(^|/)Directory\\.Packages\\.props$/"
      ],
      "matchStrings": [
        "<ConcertableCustomerVersion>(?<currentValue>[^<]+)</ConcertableCustomerVersion>"
      ],
      "depNameTemplate": "Concertable.Customer.Hosting",
      "datasourceTemplate": "nuget",
      "registryUrlTemplate": "https://nuget.pkg.github.com/Concertable/index.json",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "description": "Payment train pin",
      "managerFilePatterns": [
        "/(^|/)Directory\\.Packages\\.props$/"
      ],
      "matchStrings": [
        "<ConcertablePaymentVersion>(?<currentValue>[^<]+)</ConcertablePaymentVersion>"
      ],
      "depNameTemplate": "Concertable.Payment.Hosting",
      "datasourceTemplate": "nuget",
      "registryUrlTemplate": "https://nuget.pkg.github.com/Concertable/index.json",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "description": "Search train pin",
      "managerFilePatterns": [
        "/(^|/)Directory\\.Packages\\.props$/"
      ],
      "matchStrings": [
        "<ConcertableSearchVersion>(?<currentValue>[^<]+)</ConcertableSearchVersion>"
      ],
      "depNameTemplate": "Concertable.Search.Hosting",
      "datasourceTemplate": "nuget",
      "registryUrlTemplate": "https://nuget.pkg.github.com/Concertable/index.json",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "description": "System testing train pin",
      "managerFilePatterns": [
        "/(^|/)Directory\\.Packages\\.props$/"
      ],
      "matchStrings": [
        "<ConcertableSystemVersion>(?<currentValue>[^<]+)</ConcertableSystemVersion>"
      ],
      "depNameTemplate": "Concertable.E2E",
      "datasourceTemplate": "nuget",
      "registryUrlTemplate": "https://nuget.pkg.github.com/Concertable/index.json",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "description": "Packages in system compatibility manifests",
      "managerFilePatterns": [
        "/(^|/)compatibility[-/].*\\.(json|ya?ml)$/",
        "/(^|/)compatibility-manifest\\.(json|ya?ml)$/"
      ],
      "matchStrings": [
        "(?<datasource>nuget|npm):(?<depName>(?:@[^/\\s\"@]+/)?[^\\s\"@]+)@(?<currentValue>[^\\s\"@,\\]]+)"
      ],
      "versioningTemplate": "{{#if (equals datasource 'nuget')}}nuget{{else}}npm{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Images in compatibility and environment manifests",
      "managerFilePatterns": [
        "/(^|/)(compatibility|environments?)[-/].*\\.(json|ya?ml)$/",
        "/(^|/)(compatibility|environment)-manifest\\.(json|ya?ml)$/"
      ],
      "matchStrings": [
        "(?<depName>ghcr\\.io/concertable/[^\\s\":]+):(?<currentValue>[^\\s\"@]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Platform train in the system compatibility manifest",
      "managerFilePatterns": [
        "/(^|/)compatibility/local\\.yaml$/"
      ],
      "matchStrings": [
        "\\r?\\nplatform:\\r?\\n  packages: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "Concertable.Kernel",
      "datasourceTemplate": "nuget",
      "registryUrlTemplate": "https://nuget.pkg.github.com/Concertable/index.json",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "description": "Auth train in the system compatibility manifest",
      "managerFilePatterns": [
        "/(^|/)compatibility/local\\.yaml$/"
      ],
      "matchStrings": [
        "\\r?\\n  auth: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "Concertable.Auth.Hosting",
      "datasourceTemplate": "nuget",
      "registryUrlTemplate": "https://nuget.pkg.github.com/Concertable/index.json",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "description": "B2B train in the system compatibility manifest",
      "managerFilePatterns": [
        "/(^|/)compatibility/local\\.yaml$/"
      ],
      "matchStrings": [
        "\\r?\\n  b2b: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "Concertable.B2B.Hosting",
      "datasourceTemplate": "nuget",
      "registryUrlTemplate": "https://nuget.pkg.github.com/Concertable/index.json",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "description": "Customer train in the system compatibility manifest",
      "managerFilePatterns": [
        "/(^|/)compatibility/local\\.yaml$/"
      ],
      "matchStrings": [
        "\\r?\\n  customer: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "Concertable.Customer.Hosting",
      "datasourceTemplate": "nuget",
      "registryUrlTemplate": "https://nuget.pkg.github.com/Concertable/index.json",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "description": "Payment train in the system compatibility manifest",
      "managerFilePatterns": [
        "/(^|/)compatibility/local\\.yaml$/"
      ],
      "matchStrings": [
        "\\r?\\n  payment: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "Concertable.Payment.Hosting",
      "datasourceTemplate": "nuget",
      "registryUrlTemplate": "https://nuget.pkg.github.com/Concertable/index.json",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "description": "Search train in the system compatibility manifest",
      "managerFilePatterns": [
        "/(^|/)compatibility/local\\.yaml$/"
      ],
      "matchStrings": [
        "\\r?\\n  search: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "Concertable.Search.Hosting",
      "datasourceTemplate": "nuget",
      "registryUrlTemplate": "https://nuget.pkg.github.com/Concertable/index.json",
      "versioningTemplate": "nuget"
    }
  ],
  "packageRules": [
    {
      "description": "A test fixture is a sample of a shape, not a dependency of anything",
      "matchFileNames": [
        "**/fixtures/**"
      ],
      "enabled": false
    },
    {
      "description": "First-party packages exist only on the organization feed, as nuget.config packageSourceMapping already states",
      "matchDatasources": [
        "nuget"
      ],
      "matchPackageNames": [
        "/^Concertable\\./"
      ],
      "registryUrls": [
        "https://nuget.pkg.github.com/Concertable/index.json"
      ]
    },
    {
      "description": "Keep GitHub Actions immutable",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true,
      "groupName": "github actions"
    },
    {
      "description": "Auth producer train",
      "matchDatasources": [
        "nuget",
        "docker"
      ],
      "matchPackageNames": [
        "/^Concertable\\.Auth(?:\\.|$)/",
        "/^ghcr\\.io\\/concertable\\/auth(?:-|$)/"
      ],
      "groupName": "auth train"
    },
    {
      "description": "B2B producer train",
      "matchDatasources": [
        "nuget",
        "npm",
        "docker"
      ],
      "matchPackageNames": [
        "/^Concertable\\.B2B(?:\\.|$)/",
        "/^@concertable\\/b2b(?:-|$)/",
        "/^ghcr\\.io\\/concertable\\/b2b(?:-|$)/"
      ],
      "groupName": "b2b train"
    },
    {
      "description": "Customer producer train",
      "matchDatasources": [
        "nuget",
        "npm",
        "docker"
      ],
      "matchPackageNames": [
        "/^Concertable\\.Customer(?:\\.|$)/",
        "/^@concertable\\/customer(?:-|$)/",
        "/^ghcr\\.io\\/concertable\\/customer(?:-|$)/"
      ],
      "groupName": "customer train"
    },
    {
      "description": "Payment producer train",
      "matchDatasources": [
        "nuget",
        "docker"
      ],
      "matchPackageNames": [
        "/^Concertable\\.Payment(?:\\.|$)/",
        "/^ghcr\\.io\\/concertable\\/payment(?:-|$)/"
      ],
      "groupName": "payment train"
    },
    {
      "description": "Search producer train",
      "matchDatasources": [
        "nuget",
        "docker"
      ],
      "matchPackageNames": [
        "/^Concertable\\.Search(?:\\.|$)/",
        "/^ghcr\\.io\\/concertable\\/search(?:-|$)/"
      ],
      "groupName": "search train"
    },
    {
      "description": "Shared dotnet platform train",
      "matchDatasources": [
        "nuget"
      ],
      "matchPackageNames": [
        "/^Concertable\\.(AppHost|Build|Contracts|DataAccess|Kernel|Messaging|ServiceDefaults)(?:\\.|$)/"
      ],
      "groupName": "platform dotnet train"
    },
    {
      "description": "Shared web platform train",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "/^@concertable\\/(shared|web-shared)$/"
      ],
      "groupName": "platform web train"
    },
    {
      "description": "Never automerge breaking dependency updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "First-party trains publish per commit, so release-age latency only delays the estate against itself",
      "matchDatasources": [
        "nuget",
        "npm",
        "docker"
      ],
      "matchPackageNames": [
        "/^Concertable\\./",
        "/^@concertable\\//",
        "/^ghcr\\.io\\/concertable\\//"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "A non-breaking first-party bump merges on its own green CI",
      "matchDatasources": [
        "nuget",
        "npm",
        "docker"
      ],
      "matchPackageNames": [
        "/^Concertable\\./",
        "/^@concertable\\//",
        "/^ghcr\\.io\\/concertable\\//"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
